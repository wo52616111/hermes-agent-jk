#!/usr/bin/env bash
set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -h "$SOURCE" ]]; do
  DIR=$(cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE"
done
ROOT=$(cd -- "$(dirname -- "$SOURCE")/.." && pwd)

if [[ "${1:-}" == "update" ]]; then
  shift
  exec "$ROOT/scripts/hermes-local-update" "$@"
fi

exec "$ROOT/scripts/hermes-local-run" "$@"
