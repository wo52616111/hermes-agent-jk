#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

UPSTREAM_REMOTE=${HERMES_UPSTREAM_REMOTE:-upstream}
UPSTREAM_BRANCH=${HERMES_UPSTREAM_BRANCH:-main}

if ! git remote get-url "$UPSTREAM_REMOTE" >/dev/null 2>&1; then
  printf 'Missing git remote %q. Add it with:\n' "$UPSTREAM_REMOTE" >&2
  printf '  git remote add %s git@github.com:NousResearch/hermes-agent.git\n' "$UPSTREAM_REMOTE" >&2
  exit 1
fi

if pgrep -f "$ROOT/ui-tui/dist/entry.js" >/dev/null 2>&1; then
  printf 'Note: updating while this checkout has running TUI session(s).\n' >&2
  printf 'They keep their loaded version; exit and relaunch them after the update to use the new build.\n' >&2
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Refusing to update a dirty checkout. Commit or stash local changes first.\n' >&2
  git status --short >&2
  exit 3
fi

printf 'Fetching %s/%s...\n' "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
git fetch "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
printf 'Rebasing local changes onto %s/%s...\n' "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
git rebase "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"

uv sync --extra dev
npx -y npm@11.17.0 ci --include=dev
npx -y npm@11.17.0 run build:ink --workspace ui-tui
npx -y npm@11.17.0 run build --workspace ui-tui

HERMES_HOME_DIR=${HERMES_HOME:-$HOME/.hermes}
mkdir -p "$HERMES_HOME_DIR/skins"
cp "$ROOT/skins/jk-spaceduck.yaml" "$HERMES_HOME_DIR/skins/jk-spaceduck.yaml"
"$ROOT/.venv/bin/hermes" config set display.skin jk-spaceduck >/dev/null

printf 'Updated and built patched Hermes from %s/%s.\n' "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH"
