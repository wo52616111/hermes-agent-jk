#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

command -v uv >/dev/null 2>&1 || { printf 'hermes-local-install: uv is required\n' >&2; exit 1; }
command -v npx >/dev/null 2>&1 || { printf 'hermes-local-install: npx is required\n' >&2; exit 1; }

uv sync --extra dev
npx -y npm@11.17.0 ci --include=dev
npx -y npm@11.17.0 run build:ink --workspace ui-tui
npx -y npm@11.17.0 run build --workspace ui-tui

HERMES_HOME_DIR=${HERMES_HOME:-$HOME/.hermes}
mkdir -p "$HERMES_HOME_DIR/skins"
cp "$ROOT/skins/jk-spaceduck.yaml" "$HERMES_HOME_DIR/skins/jk-spaceduck.yaml"
"$ROOT/.venv/bin/hermes" config set display.skin jk-spaceduck >/dev/null
"$ROOT/.venv/bin/hermes" config set display.interface tui >/dev/null
"$ROOT/scripts/hermes-local-link"

printf 'Installed customized Hermes in %s\n' "$ROOT"
printf 'Run with: hermes --tui\n'
