#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

HJK_PROG=hermes-local-install
HERMES_HOME_DIR=${HERMES_HOME:-$HOME/.hermes}
# shellcheck source=scripts/hermes-local-lib.sh
source "$ROOT/scripts/hermes-local-lib.sh"

command -v uv >/dev/null 2>&1 || hjk_die 'uv is required (https://astral.sh/uv)'

hjk_sync_python
hjk_select_node
hjk_build_tui
hjk_assert_tui_built

mkdir -p "$HERMES_HOME_DIR/skins"
cp "$ROOT/skins/jk-spaceduck.yaml" "$HERMES_HOME_DIR/skins/jk-spaceduck.yaml"
"$ROOT/.venv/bin/hermes" config set display.skin jk-spaceduck >/dev/null
"$ROOT/.venv/bin/hermes" config set display.interface tui >/dev/null
"$ROOT/scripts/hermes-local-link"

printf 'Installed customized Hermes in %s\n' "$ROOT"
hjk_node_runtime_note
printf 'Run with: hermes --tui\n'
